COMPANION_HOST=0.0.0.0
COMPANION_PORT=8770

# Optional seed for user profile
COMPANION_USER_NAME=

# OpenAI-compatible (LM Studio)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=google/gemma-4-e2b

COMPANION_SENSE_INTERVAL_MS=1500
COMPANION_THINK_MIN_MS=4000
COMPANION_PROACTIVE_MS=20000
# Min ms between balloons (nudge bypasses). 0 = off.
COMPANION_SPEAK_MIN_MS=60000
# Balloon visible duration before it clears itself.
COMPANION_BALLOON_MS=10000

# Capture (Linux + Windows + macOS). Master default on.
COMPANION_CAPTURE_ALL=1
COMPANION_CAPTURE_TYPED=1
COMPANION_CAPTURE_CLIPBOARD=1
COMPANION_CAPTURE_A11Y=1
COMPANION_CAPTURE_FILES=1
COMPANION_CAPTURE_BROWSER=1
COMPANION_TYPE_IDLE_MS=2500
COMPANION_TYPE_MAX_CHARS=16000
COMPANION_PC_IDLE_MS=60000
COMPANION_WATCH_DIRS=
COMPANION_ORB_TITLE=Companion Orb
COMPANION_LOCALE=pt-BR

# Hot reload (default on). Set=0 to disable.
COMPANION_HOT_RELOAD=1
